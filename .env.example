# Local development only. `whop apps dev` injects WHOP_APP_ID and a short-lived
# WHOP_API_KEY automatically, plus every secret stored with `whop apps secrets`.
# This file is for filling gaps when running plain `npm run dev`.
#
# In production these are app secrets, not a file:
#   whop apps secrets set WHOP_COMPANY_ID=biz_xxxxxxxx

# Your Whop account. Leads, invoices, and setup checkouts are created against it.
WHOP_COMPANY_ID=biz_xxxxxxxx

# Optional: attach estimate leads to a specific product.
WHOP_PRODUCT_ID=prod_xxxxxxxx

# The three plans. `npm run bootstrap` creates them and prints these lines.
WHOP_PLAN_INSPECTION=plan_xxxxxxxx
WHOP_PLAN_REPAIR=plan_xxxxxxxx
WHOP_PLAN_DEPOSIT=plan_xxxxxxxx

# Gate for the internal billing console at /admin/billing.
ADMIN_PASSCODE=change-me

# Signing secret from `whop webhooks create`. Without it the webhook endpoint
# refuses every delivery rather than trusting an unsigned payload.
WHOP_WEBHOOK_SECRET=

# Only needed for `npm run dev` outside `whop apps dev`, and for `npm run bootstrap`.
WHOP_API_KEY=
